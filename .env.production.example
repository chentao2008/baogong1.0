APP_NAME=employee-work-report
COMPOSE_PROJECT_NAME=employee_work_report
# First HTTP/IP deployment uses development so cookies work over plain HTTP.
# Change to production after switching to HTTPS.
APP_ENV=development

POSTGRES_DB=employee_work_report
POSTGRES_USER=employee_work
POSTGRES_PASSWORD=change-this-database-password
DATABASE_URL=postgresql+asyncpg://employee_work:change-this-database-password@db:5432/employee_work_report

FRONTEND_ORIGINS=http://your-server-ip
SESSION_COOKIE_NAME=employee_work_session
SESSION_TTL_SECONDS=31536000
SESSION_COOKIE_SECURE=false
PASSWORD_VIEW_SECRET=change-this-to-a-long-random-secret

LOGIN_MAX_FAILURES=5
LOGIN_LOCKOUT_SECONDS=900

INITIAL_ADMIN_ACCOUNT=admin
INITIAL_ADMIN_PASSWORD=change-this-admin-password
INITIAL_ADMIN_NAME=管理员
INITIAL_ADMIN_ROLE=admin
