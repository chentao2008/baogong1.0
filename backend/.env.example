APP_NAME=employee-work-report
APP_ENV=development
DATABASE_URL=postgresql+asyncpg://postgres:your_password@localhost:5432/employee_work_report
FRONTEND_ORIGINS=http://127.0.0.1:8080,http://localhost:8080
SESSION_COOKIE_NAME=employee_work_session
SESSION_TTL_SECONDS=43200
# Set to true in HTTPS production environments.
SESSION_COOKIE_SECURE=false
PASSWORD_VIEW_SECRET=change-me-to-a-long-random-secret
